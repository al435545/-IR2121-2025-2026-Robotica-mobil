#include <chrono>
#include <cmath>
#include <vector>
#include <iostream>

#include "rclcpp/rclcpp.hpp"
#include "geometry_msgs/msg/pose_stamped.hpp"
#include "tf2_ros/transform_listener.h"
#include "tf2_ros/buffer.h"
#include "tf2_geometry_msgs/tf2_geometry_msgs.hpp"
#include "tf2/utils.h"

using namespace std::chrono_literals;

// ================= PARAMETROS GLOBALES =================
// Tolerancia de distancia: se usan 2 valores dependiendo de si el robot está casi parado o en movimiento [cite: 295, 299]
constexpr double DIST_TOL_CLOSE = 0.45; // Cuando el robot va lento o está parado [cite: 295, 678]
constexpr double DIST_TOL_FAR = 0.30;   // Cuando aún va moviéndose [cite: 295, 680]
constexpr double YAW_TOL = 0.30;        // Tolerancia de orientación en radianes [cite: 304]
constexpr double STOP_EPS = 0.02;       // Distancia mínima de movimiento entre ciclos para considerarse parado [cite: 305]
constexpr double SPEED_EPS = 0.05;      // Velocidad umbral para considerar movimiento "muy lento" [cite: 306, 670]

// ================= FUNCIONES AUXILIARES (Utils) =================

// Calcula la distancia euclidiana entre dos puntos en el plano XY [cite: 312, 323]
double planarDistance(double x1, double y1, double x2, double y2) {
    return std::hypot(x1 - x2, y1 - y2); [cite: 317]
}

// Calcula la diferencia angular mínima normalizada entre dos ángulos yaw [cite: 321, 325]
double yawError(double yaw1, double yaw2) {
    double err = yaw1 - yaw2; [cite: 335]
    // Normaliza el ángulo al rango [-PI, PI] [cite: 330]
    while (err > M_PI) err -= 2.0 * M_PI;
    while (err < -M_PI) err += 2.0 * M_PI;
    return std::fabs(err); // Devuelve el error absoluto [cite: 331]
}

// Convierte un cuaternión de un mensaje de ROS a ángulo Yaw (giro sobre el eje Z) [cite: 355, 356]
double quatToYaw(const geometry_msgs::msg::Quaternion &q) {
    tf2::Quaternion tf_q;
    tf2::fromMsg(q, tf_q); [cite: 349]
    return tf2::getYaw(tf_q); [cite: 351]
}

// Estructura para definir un Waypoint con posición y orientación [cite: 361, 363]
struct Waypoint {
    double x;
    double y;
    double yaw;
};

// ================= FUNCIÓN PRINCIPAL =================

int main(int argc, char **argv) {
    rclcpp::init(argc, argv); [cite: 389]
    auto node = rclcpp::Node::make_shared("patrol_waypoints_tf2_yaw_v2"); [cite: 384]

    // Herramientas para escuchar transformaciones entre frames (map -> base_link) [cite: 396]
    auto tf_buffer = std::make_shared<tf2_ros::Buffer>(node->get_clock());
    auto tf_listener = std::make_shared<tf2_ros::TransformListener>(*tf_buffer);

    // Publicador para enviar órdenes de posición y orientación al robot [cite: 402, 411]
    auto goal_pub = node->create_publisher<geometry_msgs::msg::PoseStamped>("/goal_pose", 10);

    // Ruta que el robot debe patrullar [cite: 407, 413]
    std::vector<Waypoint> waypoints = {
        {-3.89, 7.86, -0.01},
        {-7.32, 7.58, -0.01},
        {-4.34, 7.22, -0.03},
        {-4.20, 3.26, -0.03}
    };

    // Variables de estado [cite: 435]
    size_t wp_index = 0;
    rclcpp::Time last_goal_sent = node->get_clock()->now();
    double last_x = 0.0, last_y = 0.0;
    bool position_reached = false; // Controla si estamos en Fase 1 (posición) o Fase 2 (yaw) [cite: 450, 451]

    geometry_msgs::msg::PoseStamped goal_msg;
    goal_msg.header.frame_id = "map"; [cite: 455]

    rclcpp::WallRate loop_rate(10); // Bucle a 10 Hz [cite: 457, 734]
    RCLCPP_INFO(node->get_logger(), "Patrulla iniciada (2 fases: posición + yaw)"); [cite: 458]

    while (rclcpp::ok() && wp_index < waypoints.size()) {
        rclcpp::spin_some(node);

        double rx, ry, ryaw;
        try {
            // Obtiene la pose actual del robot preguntando a TF2 [cite: 475, 477]
            auto tf = tf_buffer->lookupTransform("map", "base_link", tf2::TimePointZero); [cite: 479]
            rx = tf.transform.translation.x; [cite: 486]
            ry = tf.transform.translation.y; [cite: 489]
            ryaw = quatToYaw(tf.transform.rotation); [cite: 492]
        } catch (tf2::TransformException &e) {
            RCLCPP_WARN_THROTTLE(node->get_logger(), *node->get_clock(), 2000, "Esperando TF map->base_link"); [cite: 519, 522]
            loop_rate.sleep();
            continue;
        }

        // Estimación de movimiento y velocidad [cite: 524]
        double delta_move = planarDistance(last_x, last_y, rx, ry); [cite: 534]
        double est_speed = delta_move * 10.0; // Multiplicado por la frecuencia del loop (10Hz) [cite: 536, 663]
        bool stopped = (delta_move < STOP_EPS); [cite: 528]

        // Publicación periódica del objetivo cada 1 segundo o si el robot se detiene [cite: 516, 529]
        if ((node->get_clock()->now() - last_goal_sent).seconds() > 1.0 || stopped) {
            const auto &wp = waypoints[wp_index];
            goal_msg.header.stamp = node->get_clock()->now(); [cite: 543]
            goal_msg.pose.position.x = wp.x; [cite: 554]
            goal_msg.pose.position.y = wp.y; [cite: 556]

            tf2::Quaternion q;
            q.setRPY(0.0, 0.0, wp.yaw); [cite: 565]
            goal_msg.pose.orientation = tf2::toMsg(q); [cite: 566]

            goal_pub->publish(goal_msg); [cite: 567]
            last_goal_sent = node->get_clock()->now();
        }

        last_x = rx;
        last_y = ry;

        const auto &wp = waypoints[wp_index];
        double dist_err = planarDistance(rx, ry, wp.x, wp.y); [cite: 607]
        double yaw_err = yawError(ryaw, wp.yaw); [cite: 608]

        // Tolerancia adaptativa según la velocidad estimada [cite: 609, 676]
        double dist_tol = (est_speed < SPEED_EPS) ? DIST_TOL_CLOSE : DIST_TOL_FAR; [cite: 611, 616]

        // FASE 1: Llegar a la posición [cite: 612]
        if (!position_reached && dist_err < dist_tol) {
            position_reached = true; [cite: 618]
            RCLCPP_INFO(node->get_logger(), "WP %zu: posición alcanzada, ajustando orientación...", wp_index + 1); [cite: 625]
        }

        // FASE 2: Ajustar Yaw (girar) [cite: 626]
        if (position_reached && yaw_err < YAW_TOL) {
            RCLCPP_INFO(node->get_logger(), "Waypoint %zu COMPLETADO (dist=%.2f, yaw=%.2f)", wp_index + 1, dist_err, yaw_err); [cite: 631]
            position_reached = false; [cite: 636]
            wp_index++; [cite: 639]
        }

        loop_rate.sleep(); [cite: 650]
    }

    RCLCPP_INFO(node->get_logger(), "Ruta finalizada correctamente"); [cite: 652]
    rclcpp::shutdown(); [cite: 653]
    return 0;
}
